msgid "Where it applies"
msgstr "Πού εφαρμόζεται"

#: includes/class-pncp-admin.php:359
msgid "Posts"
msgstr "Άρθρα"

#: includes/class-pncp-admin.php:360
msgid "Pages"
msgstr "Σελίδες"

#: includes/class-pncp-admin.php:361
